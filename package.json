{
    "private": true,
    "type": "module",
    "scripts": {
        "dev:styles": "npx @tailwindcss/cli -i resources/css/$THEME.css -o resources/dist/$THEME.css --watch",
        "build:styles": "npx @tailwindcss/cli -i resources/css/$THEME.css -o resources/dist/$THEME.css --minify",
        "dev": "npm-run-all --parallel dev:*",
        "build": "npm-run-all build:*"
    },
    "devDependencies": {
        "@tailwindcss/cli": "^4.1.0",
        "@tailwindcss/postcss": "^4.1.0",
        "npm-run-all": "^4.1.5",
        "postcss": "^8.5.0",
        "prettier": "^3.0.0",
        "prettier-plugin-tailwindcss": "^0.6.0",
        "tailwindcss": "^4.1.0"
    }
}
